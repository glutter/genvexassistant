# Genvex Assistant, native (systemd) hosting.
#
# Install as /etc/genvexassistant.env, owned by root, mode 600. It holds the unit's address and the account
# e-mail, so it must never be committed. systemd reads plain KEY=value lines: no "export", no quotes.
#
# Every option of the Home Assistant add-on (ha_addon/config.json) appears below under its environment name,
# with the add-on's default. src/test/native-env.test.cjs keeps this file, run.sh and the Java defaults in step.
# To migrate a running add-on, turn its options.json into this format with:
#   jq -r 'del(.cooling_target_temp) | to_entries[] | "\(.key|ascii_upcase)=\(.value)"' options.json

# --- Required ---
# Address of the ventilation unit (UDP 5570) and the e-mail it was registered with.
GENVEX_IP=
GENVEX_EMAIL=

# --- Hosting (the unit file normally sets these; uncomment only to override) ---
# GENVEX_HOSTING=native
# GENVEX_DB_PATH=/var/lib/genvexassistant/genvex.db
# GENVEX_WEB_BIND=127.0.0.1
# GENVEX_WEB_PORT=3100
# Native refuses a non-loopback GENVEX_WEB_BIND: the API has no login. Only with access control in front of it:
# GENVEX_ALLOW_REMOTE_BIND=true
# TZ=Europe/Copenhagen
# Optional. Comma-separated host names a request may use; loopback is always allowed. Empty switches the check off.
# GENVEX_ALLOWED_HOSTS=

# --- Sunset (evening cooling) ---
# Without both, evening cooling starts at COOLING_FALLBACK_START, hours before sunset in summer.
# Take the values from Home Assistant's .storage/core.config. Degrees, north and east positive.
GENVEX_LATITUDE=
GENVEX_LONGITUDE=

# --- Polling and mode ---
POLL_INTERVAL=30
MONITOR_ONLY=false
TEMP_SUPPLY_OFFSET_RAW=-300

# --- Humidity control ---
BOOST_ENABLED=true
HUMIDITY_RISE_THRESHOLD=4
BOOST_SPEED=3
NORMAL_SPEED=1
BOOST_DURATION_MINUTES=15
HUMIDITY_BASELINE_MINUTES=30
HUMIDITY_RECOVERY_TOLERANCE=1
HUMIDITY_VERY_HIGH_THRESHOLD=80
HUMIDITY_HIGH_THRESHOLD=65
HUMIDITY_LOW_THRESHOLD=30
HUMIDITY_HYSTERESIS=3
NIGHT_START=22:00
NIGHT_END=06:30

# --- Evening cooling ---
EVENING_COOLING_ENABLED=true
COOLING_STOP_TEMP=22.0
COOLING_START_TEMP=22.5
COOLING_MIN_SUPPLY_TEMP=15.0
COOLING_FALLBACK_START=18:00
COOLING_ESCALATION_MINUTES=30

# --- Fan command pacing ---
FAN_MIN_COMMAND_INTERVAL_SECONDS=120
FAN_RETRY_INTERVAL_SECONDS=120
FAN_MAX_RETRY_INTERVAL_SECONDS=1800
FAN_RETRY_ATTEMPTS_BEFORE_BACKOFF=3
BYPASS_UNKNOWN_TOLERANCE=3

# --- Heat loss guard ---
HEAT_LOSS_GUARD_ENABLED=true
HEAT_LOSS_INDOOR_TEMP_C=23.0
HEAT_LOSS_TEMP_DELTA_C=5.0
HEAT_LOSS_PROBE_MINUTES=10
HEAT_LOSS_PROGRESS_G_PER_KG=0.15
HEAT_LOSS_PEAK_MARGIN_G_PER_KG=0.3
